{
  "name": "@brillout/release-me",
  "version": "0.5.6",
  "repository": "https://github.com/brillout/release-me",
  "scripts": {
    "// === Dev ===": "",
    "dev": "tsc --watch",
    "// === Build ===": "",
    "build": "rm -rf dist/ && tsc",
    "// === Test ===": "",
    "test": "vitest run",
    "========= Formatting": "",
    "format": "pnpm run format:biome",
    "format:prettier": "git ls-files | egrep '\\.(json|js|jsx|css|ts|tsx|vue|mjs|cjs)$' | grep --invert-match package.json | xargs pnpm exec prettier --write",
    "format:biome": "biome format --write .",
    "format:check": "biome format . || echo Fix formatting by running: $ pnpm -w run format",
    "// === Release ===": "",
    "release": "release-me patch",
    "release:minor": "release-me minor",
    "release:commit": "release-me commit"
  },
  "dependencies": {
    "@brillout/picocolors": "^1.0.28",
    "commander": "^11.1.0",
    "conventional-changelog": "7.0.2",
    "conventional-changelog-angular": "8.0.0",
    "execa": "^5.1.1",
    "semver": "^7.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.5.3",
    "@brillout/release-me": "link:./",
    "@types/node": "^20.8.5",
    "@types/semver": "^7.5.3",
    "prettier": "^2.8.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "// ./src/cli.ts — For @brillout/release-me's own releases: runs the source (Node.js strips its types)": "",
  "// ./dist/cli.js — For @brillout/release-me users": "",
  "bin": "./src/cli.ts",
  "publishConfig": {
    "bin": "./dist/cli.js",
    "access": "public"
  },
  "files": [
    "dist/",
    ".github/workflows/release-npm.yml",
    ".github/workflows/release-github.yml"
  ],
  "packageManager": "pnpm@12.23.0",
  "type": "module",
  "license": "MIT"
}
